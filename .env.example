# Copy to .env for local development. Never commit .env.
MONGODB_URL=mongodb://127.0.0.1:27017/uwa_db
PORT=4000
# Generate a private local secret, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-private-local-secret
# Development uploads are stored in var/uploads and served at /uploads.
# Production uploads require explicit persistent filesystem storage:
# UPLOAD_STORAGE=filesystem
# UPLOAD_DIR=/absolute/path/to/a/persistent/uwa-uploads-volume
# Optional HTTPS public storage prefix (for example https://assets.example.com/uploads):
# UPLOAD_PUBLIC_BASE_URL=https://assets.example.com/uploads
# Set only the trusted reverse proxy addresses/CIDRs or exact hop count, if required.
# TRUST_PROXY=1
# Isolated admin testing: see docs/ADMIN_DASHBOARD.md (ports 5002/3002).
# TEST_MONGODB_URL=mongodb://127.0.0.1:27017/uwa_admin_test_integration
