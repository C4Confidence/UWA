# Express server used by the same-origin /api proxy.
API_ORIGIN=http://127.0.0.1:4000
# Set the actual store currency before launch. The previous UI used USD;
# the existing database has no currency field. This does not convert prices.
NEXT_PUBLIC_STORE_CURRENCY=USD
# Public origin for canonical metadata. Use your real domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated trusted image hosts for server-side image optimization.
IMAGE_HOSTS=res.cloudinary.com,images.unsplash.com
